diff --git a/cache-redis/redis.go b/cache-redis/redis.go
index f62b048..e698c5a 100644
--- a/cache-redis/redis.go
+++ b/cache-redis/redis.go
@@ -25,6 +25,7 @@ import (
 	_ "embed"
 	"encoding/json"
 	"fmt"
+	"strings"
 	"time"
 
 	"github.com/apache/answer-plugins/cache-redis/i18n"
@@ -183,10 +184,16 @@ func (c *Cache) ConfigReceiver(config []byte) error {
 	_ = json.Unmarshal(config, conf)
 	c.Config = conf
 
-	c.RedisClient = redis.NewClient(&redis.Options{
-		Addr:     conf.Endpoint,
-		Username: conf.Username,
-		Password: conf.Password,
-	})
+	endpoint := conf.Endpoint
+	if !strings.Contains(endpoint, "://") {
+		endpoint = "redis://" + endpoint
+	}
+	options, err := redis.ParseURL(endpoint)
+	if err != nil {
+		return err
+	}
+	options.Username = conf.Username
+	options.Password = conf.Password
+	c.RedisClient = redis.NewClient(options)
 	return nil
 }
